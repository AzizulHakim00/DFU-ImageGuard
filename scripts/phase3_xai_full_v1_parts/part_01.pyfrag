def sha256_file(path: Path, chunk=8 * 1024 * 1024) -> str:
    h = hashlib.sha256()
    with Path(path).open("rb") as f:
        for b in iter(lambda: f.read(chunk), b""):
            h.update(b)
    return h.hexdigest()


def atomic_csv(path: Path, df: pd.DataFrame) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    df.to_csv(tmp, index=False)
    os.replace(tmp, path)


def atomic_json(path: Path, obj: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(obj, indent=2, ensure_ascii=False, default=str), encoding="utf-8")
    os.replace(tmp, path)


def ensure_packages() -> None:
    import importlib.util
    pkgs = {
        "timm": "timm>=1.0.15",
        "pytorch_grad_cam": "grad-cam>=1.5.4",
        "captum": "captum>=0.7.0",
        "lime": "lime>=0.2.0.1",
        "shap": "shap>=0.46.0",
        "skimage": "scikit-image>=0.22.0",
        "kagglehub": "kagglehub>=0.3.0",
    }
    missing = [pip for mod,pip in pkgs.items() if importlib.util.find_spec(mod) is None]
    if missing:
        print("Installing XAI-only dependencies:", ", ".join(missing))
        subprocess.check_call([sys.executable, "-m", "pip", "install", "-q", *missing])


